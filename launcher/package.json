{
  "name": "valor-launcher",
  "productName": "Valor",
  "version": "0.1.0",
  "description": "Valor Client launcher",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "electron-updater": "6.3.9",
    "tar": "6.2.1"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.vaelohq.valor",
    "productName": "Valor",
    "files": [
      "src/**/*",
      "news.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/valor.jar",
        "to": "valor.jar"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "Valor"
    },
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "VaeloHQ",
        "repo": "Valor",
        "releaseType": "release"
      }
    ]
  },
  "author": "VaeloHQ",
  "repository": "https://github.com/VaeloHQ/Valor"
}
